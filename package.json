{
  "name": "minmax-avg-bar-card",
  "version": "1.3.6",
  "private": true,
  "scripts": {
    "build": "terser minmax-avg-bar-card_src.js --compress --mangle --module --output minmax-avg-bar-card.js",
    "check": "node --input-type=module --check < minmax-avg-bar-card_src.js && node --input-type=module --check < minmax-avg-bar-card.js",
    "verify": "npm run check && npm run build && git diff --exit-code -- minmax-avg-bar-card.js"
  },
  "devDependencies": {
    "terser": "^5.39.0"
  }
}
